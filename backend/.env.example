PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/careconnect?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
OTP_EXPIRES_MINUTES=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ADMIN_NAME=CareConnect Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=9000000000
ADMIN_PASSWORD=replace_with_a_strong_unique_password
